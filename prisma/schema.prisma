// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model MerchantSettings {
  id                String   @id @default(cuid())
  shop              String   @unique
  sellerName        String   @default("")
  sellerAddress     String   @default("")
  sellerTaxId       String   @default("")
  sellerBranch      String   @default("00000")
  sellerEmail       String   @default("")
  sellerPhone       String   @default("")
  invoicePrefix     String   @default("TX-")
  nextInvoiceNumber Int      @default(1)
  vatRate           String   @default("7")
  priceIncludesVat  Boolean  @default(true)
  invoiceLanguage   String   @default("th-en")
  issueTiming       String   @default("order_created")
  autoEmail         Boolean  @default(true)
  logoDataUrl       String?
  signatureDataUrl  String?
  stampDataUrl      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TaxInvoiceRequest {
  id            String   @id @default(cuid())
  shop          String
  cartToken     String?
  orderGid      String?
  orderName     String?
  customerEmail String
  buyerType     String   @default("individual")
  buyerName     String
  buyerTaxId    String?
  buyerBranch   String?
  buyerAddress  String
  status        String   @default("waiting_for_order")
  orderJson     String?
  invoiceId     String?
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shop, status])
  @@index([shop, cartToken])
  @@index([shop, orderGid])
  @@index([shop, orderName])
}

model TaxInvoice {
  id            String   @id @default(cuid())
  shop          String
  orderGid      String
  orderName     String
  invoiceNumber String
  customerEmail String
  snapshotJson  String
  emailSentAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, orderGid])
  @@unique([shop, invoiceNumber])
  @@index([shop, createdAt])
}

model WebhookEvent {
  id          String   @id
  shop        String
  topic       String
  processedAt DateTime @default(now())
}
